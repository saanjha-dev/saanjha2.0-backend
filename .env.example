# Copy this file to `.env` (already gitignored) to override any of the
# dev-only defaults baked into docker-compose.yml. Every var here is
# optional for local dev - docker-compose.yml falls back to a working
# default for each one. For a real deployment (staging/prod), none of these
# should come from a file like this at all - use your platform's real
# secret storage (e.g. environment variables injected by your host/orchestrator),
# and see application-prod.yml for the full list of variables prod requires
# with NO default (it fails to start rather than silently falling back to
# something insecure).

# --- Postgres ---
POSTGRES_DB=saanjha_auth
POSTGRES_USER=saanjha_user
POSTGRES_PASSWORD=devlocalpass

# --- RabbitMQ ---
RABBITMQ_USER=saanjha_mq_user
RABBITMQ_PASSWORD=devlocalmqpass

# --- Backend application ---
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=*

# Mail (SMTP) - leave blank for local dev unless you're testing email delivery
MAIL_ID=
MAIL_PASSWORD=

# Cloudinary (media uploads) - leave blank unless testing upload flows locally
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Notification Hub SDK - the app's own config validates these are non-blank
# at startup even in dev, so a placeholder is provided by default in
# docker-compose.yml; override here only if you're actually testing
# notification delivery against a real Notification Hub account.
NOTIFICATION_HUB_API_KEY=dev-placeholder
NOTIFICATION_HUB_API_SECRET=dev-placeholder
NOTIFICATION_WEBHOOK_SECRET=dev-placeholder


